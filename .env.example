# Backend Environment Variables
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ayurveda_ip_corpus

# Embeddings & Reranker API (BGE-M3 & BGE-reranker-v2-m3)
EMBEDDING_API_URL=https://api.together.xyz/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

RERANKER_API_URL=https://api.together.xyz/v1/rerank
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Generation LLM (Gemini or Claude)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=

# Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_MEDIUM_THRESHOLD=0.45

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
